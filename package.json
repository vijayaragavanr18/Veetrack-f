{
  "name": "veetrack",
  "version": "1.0.0",
  "private": true,
  "description": "VeeTrack AI — Media Intelligence Platform",
  "scripts": {
    "dev": "bun --cwd veetrack-frontend run dev",
    "dev:frontend": "cd veetrack-frontend && bun run dev",
    "dev:backend": "cd veetrack-backend && bash start.sh",
    "dev:all": "concurrently \"bun run dev\" \"bun run dev:backend\"",
    "install:frontend": "cd veetrack-frontend && bun install",
    "install:backend": "cd veetrack-backend && pip install -r requirements.txt",
    "build": "cd veetrack-frontend && bun run build",
    "start": "cd veetrack-frontend && bun run start",
    "lint": "cd veetrack-frontend && bun run lint",
    "kill-ports": "bash kill-ports.sh",
    "fresh": "bash kill-ports.sh && bun run dev"
  }
}
