{
  "name": "veetrack",
  "version": "1.0.0",
  "private": true,
  "description": "VeeTrack AI — Media Intelligence Platform by Vee Technologies",
  "scripts": {
    "dev":           "npm run dev --prefix veetrack-frontend",
    "dev:frontend":  "cd veetrack-frontend && npm run dev",
    "dev:backend":   "bash scripts/start-backend.sh",
    "dev:all":       "concurrently --names FRONT,BACK --prefix-colors cyan,yellow \"npm run dev:frontend\" \"npm run dev:backend\"",
    "setup":         "bash scripts/setup.sh",
    "kill":          "bash scripts/kill-ports.sh",
    "fresh":         "bash scripts/kill-ports.sh && npm run dev:all",
    "build":         "cd veetrack-frontend && npm run build",
    "start":         "cd veetrack-frontend && npm run start",
    "lint":          "cd veetrack-frontend && npm run lint",
    "install:all":   "npm install && cd veetrack-frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
