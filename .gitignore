venv/
*.egg

# --- Database ---
db/
*.db
*.sqlite
*.sqlite3

# --- Prisma ---
prisma/*.db

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
dev.log
npm-debug.log*

# --- Sandbox / CI artifacts ---
.agent-browser/
.cache/
.zscripts/
veetrack-project.tar.gz
worklog.md
