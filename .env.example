# VeeTrack — AI-Powered Media Intelligence Platform
# Copy this to .env and fill in your values

# SOURCE 1: GDELT 2.0 — Global Event Radar
GDELT_API_URL=https://api.gdeltproject.org/api/v2

# SOURCE 2: RSS Feeds — Content Engine
RSS_FEEDS=https://feeds.feedburner.com/ndtvnews-latest,https://www.thehindu.com/news/feeder/default.rss,https://economictimes.indiatimes.com/rssfeedsdefault.cms

# SOURCE 3: Hacker News — Tech Pulse (Algolia API)
HN_API_URL=https://hn.algolia.com/api/v1

# SOURCE 4: Mastodon — Social Sentiment
MASTODON_BASE_URL=https://mastodon.social

# SOURCE 5: Wikipedia — Background Context
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# SOURCE 6: Wikidata — Entity Intelligence
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php

# BACKEND SETTINGS
REDIS_URL=redis://localhost:6379/0
