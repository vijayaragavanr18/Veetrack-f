# VeeTrack — Environment Configuration Template
# Copy this to .env and fill in values

# ── Redis (required for trend history and chat sessions) ─────────
REDIS_URL=redis://localhost:6379/0

# ── FastAPI Backend ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Ollama (local LLM — fallback if not running) ─────────────────
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull qwen2.5:1.5b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b

# ── NewsData.io backup source (optional, free 200 req/day) ───────
NEWSDATA_API_KEY=

# ── Email delivery for daily PDF reports (optional) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=reports@veetechnologies.com

# ── Google News ───────────────────────────────────────────────────
GOOGLE_NEWS_REGION=IN
GOOGLE_NEWS_LANGUAGE=en-IN
